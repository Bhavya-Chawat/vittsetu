# Needed for the LLM features (RAG chat + /api/interpret). Without it the app still
# starts and everything else works; those two endpoints return 503.
GROQ_API_KEY=

# Optional — model used for chat generation and requirement interpretation
GROQ_MODEL=openai/gpt-oss-20b

# Optional — where api.py looks for voice_service (STT/TTS). Defaults shown.
VOICE_SERVICE_URL=http://localhost:8001

# Optional — only needed to run voice_service (its ASR/TTS models are gated on Hugging Face)
HF_TOKEN=

# Admin console auth — change for anything beyond local dev
ADMIN_TOKEN=vittsetu-admin-dev

# Optional — set to "production" to refuse the default ADMIN_TOKEN above
VITTSETU_ENV=

# Optional — comma-separated browser origins allowed to call the API cross-origin.
# Default covers the Vite dev server and localhost:8000; the built frontend is same-origin.
# VITTSETU_CORS_ORIGINS=https://vittsetu.example.org

# Optional — partner routing thresholds (see README "Partner Routing"). Any
# RoutingPolicy field can be overridden as VITTSETU_ROUTING_<FIELD>, e.g.:
# VITTSETU_ROUTING_NPA_EXCLUDE_PCT=10
# VITTSETU_ROUTING_MAX_METRICS_AGE_DAYS=365
